# =============================================
# Shopira Pro - Environment Variables
# =============================================

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=123456789

# Database
DATABASE_URL=sqlite+aiosqlite:///./shopira.db
# For production: postgresql+asyncpg://user:pass@localhost/shopira

# Redis (optional but recommended)
REDIS_URL=redis://localhost:6379/0

# Pasargad Payment Gateway
PASARGAD_MERCHANT_CODE=your_merchant_code
PASARGAD_TERMINAL_ID=your_terminal_id
PASARGAD_CERTIFICATE_PATH=./cert/pasargad_cert.xml
PASARGAD_CALLBACK_URL=https://yourdomain.com/payment/callback

# AI Support (OpenAI or local)
OPENAI_API_KEY=sk-...
AI_ENABLED=true

# Mini App
MINIAPP_URL=https://yourdomain.com/miniapp

# Other
DEBUG=true
LOG_LEVEL=INFO
